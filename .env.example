TRAIN_EPISODES=10000
EVAL_GAMES=200

# Player sign-in email. Gmail requires an App Password, not your normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail.addr.here@gmail.com
SMTP_PASS=your-gmail-app-password

# Set true when the site is served over HTTPS.
QWIXX_COOKIE_SECURE=false


# Interactive deployment: browsers generate training games while the QNAP
# learns in the background without running its own rollout workers.
QWIXX_TRAINING_ENABLED=true
QWIXX_CENTRAL_WORKERS=0
QWIXX_BROWSER_TRAINING_ENABLED=true
QWIXX_INFERENCE_ONLY=false
QWIXX_TORCH_THREADS=1
QWIXX_MAX_BROWSER_WORKERS=2

# Keep background optimizer work polite on an interactive host.
QWIXX_TRAINING_UPDATES_PER_CYCLE=1
QWIXX_TRAINING_CYCLE_SLEEP=0.20
QWIXX_CHECKPOINT_IDLE_SECONDS=120
